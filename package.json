{
  "name": "myws",
  "version": "1.0.0",
  "description": "A demo application showcasing a micro frontend architecture",
  "author": "Maurizio Cescon <maurizio.cescon@gmail.com>",
  "homepage": "https://be.linkedin.com/in/mauriziocescon",
  "private": false,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "postinstall": "npm run build:all",
    "start": "tsc -p ./mock-server/tsconfig.json && node --env-file=.env.production ./dist/server/server.js",
    "json-server": "node ./mock-server/server.ts",
    "json-server-watch": "node --watch-path=./mock-server ./mock-server/server.ts",
    "build:host": "ng build host",
    "build:mf1": "ng build @mf/mf1-entry && node scripts/bundle-mf.ts mf1",
    "build:mf2": "ng build @mf/mf2-entry && node scripts/bundle-mf.ts mf2",
    "build:mf3": "ng build @mf/mf3-entry && node scripts/bundle-mf.ts mf3",
    "build:mf4": "ng build @mf/mf4-entry && node scripts/bundle-mf.ts mf4",
    "build:all": "npm run build:mf1 && npm run build:mf2 && npm run build:mf3 && npm run build:mf4 && npm run build:host",
    "ng": "ng",
    "serve": "concurrently \"ng serve host --open\" \"npm run json-server-watch\"",
    "serve:host": "npm run build:all && concurrently \"ng serve host --open --configuration debug\" \"npm run json-server-watch\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test @mf/integration --no-watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauriziocescon/myws"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/brentertz/scapegoat/blob/master/LICENSE-MIT"
    }
  ],
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/elements": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@faker-js/faker": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/json-server": "^0.14.7",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "json-server": "^0.17.4",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  }
}
